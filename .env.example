# Variables de entorno - Ejemplo para Monorepo Local y Despliegue
ENVIRONMENT=development

# Conexión a Base de Datos PostgreSQL (asíncrono con asyncpg)
DATABASE_URL=postgresql+asyncpg://libreria_user:libreria_password@db:5432/libreria_db

# Upstream del Backend para Nginx Reverse Proxy
API_UPSTREAM=backend:8000
